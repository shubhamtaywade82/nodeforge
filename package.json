{
  "name": "nodeforge",
  "private": true,
  "version": "0.0.1",
  "description": "NodeForge — autonomous Node.js/TypeScript engineering workspace. Orchestration core for VS Code and Cursor.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" run build",
    "typecheck": "pnpm -r --filter \"./packages/**\" run typecheck",
    "test": "pnpm -r --filter \"./packages/**\" run test",
    "test:unit": "pnpm -r --filter \"./packages/**\" run test:unit",
    "clean": "pnpm -r --filter \"./packages/**\" exec rm -rf dist *.tsbuildinfo .turbo",
    "package": "pnpm -C packages/extension run package",
    "lint": "echo \"[nodeforge] root lint placeholder — install @biomejs/biome or eslint per workspace\" && exit 0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5.6.3"
  }
}

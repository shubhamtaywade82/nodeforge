{
  "name": "@nodeforge/contracts",
  "version": "0.0.1",
  "private": true,
  "description": "Normalized engineering contracts shared across all NodeForge packages.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo \"[contracts] no runtime tests — pure type module\" && exit 0",
    "test:unit": "echo \"[contracts] no runtime tests\" && exit 0",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}

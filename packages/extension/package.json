{
  "name": "nodeforge",
  "displayName": "NodeForge",
  "description": "Autonomous Node.js/TypeScript engineering workspace — orchestration core for VS Code and Cursor.",
  "version": "0.0.1",
  "publisher": "nodeforge",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other", "Programming Languages", "Testing", "Debuggers"],
  "keywords": ["node", "typescript", "eslint", "biome", "vitest", "jest", "prisma", "drizzle", "ai", "cursor"],
  "activationEvents": [
    "onCommand:nodeforge.analyzeWorkspace",
    "onCommand:nodeforge.runDiagnostics",
    "onCommand:nodeforge.runTests",
    "onView:nodeforge.workspace",
    "onView:nodeforge.chat",
    "onView:nodeforge.docs"
  ],
  "main": "./dist/extension.cjs",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Workspace inspection, configuration display, and read-only diagnostics run in Restricted Mode. Running commands, tests, processes, and agent execution require Workspace Trust."
    }
  },
  "contributes": {
    "taskDefinitions": [
      {
        "type": "nodeforge",
        "required": ["script"],
        "properties": {
          "script": {
            "type": "string",
            "description": "The package.json script to run"
          }
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nodeforge-sidebar",
          "title": "NodeForge",
          "icon": "media/nodeforge.svg"
        }
      ]
    },
    "views": {
      "nodeforge-sidebar": [
        {
          "id": "nodeforge.workspace",
          "name": "Workspace"
        },
        {
          "id": "nodeforge.diagnostics",
          "name": "Diagnostics"
        },
        {
          "id": "nodeforge.tests",
          "name": "Tests"
        },
        {
          "id": "nodeforge.runtime",
          "name": "Runtime"
        },
        {
          "id": "nodeforge.git",
          "name": "Git"
        },
        {
          "id": "nodeforge.database",
          "name": "Database"
        },
        {
          "id": "nodeforge.dependencies",
          "name": "Dependencies"
        },
        {
          "id": "nodeforge.chat",
          "type": "webview",
          "name": "Chat"
        },
        {
          "id": "nodeforge.docs",
          "type": "webview",
          "name": "Docs"
        },
        {
          "id": "nodeforge.agent",
          "name": "Agent"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "nodeforge.analyzeWorkspace",
          "when": "view == nodeforge.workspace",
          "group": "navigation"
        },
        {
          "command": "nodeforge.runDiagnostics",
          "when": "view == nodeforge.diagnostics",
          "group": "navigation"
        },
        {
          "command": "nodeforge.runTests",
          "when": "view == nodeforge.tests",
          "group": "navigation"
        },
        {
          "command": "nodeforge.refreshGit",
          "when": "view == nodeforge.git",
          "group": "navigation"
        },
        {
          "command": "nodeforge.detectDatabase",
          "when": "view == nodeforge.database",
          "group": "navigation"
        },
        {
          "command": "nodeforge.auditDependencies",
          "when": "view == nodeforge.dependencies",
          "group": "navigation"
        },
        {
          "command": "nodeforge.analyzeDependencyGraph",
          "when": "view == nodeforge.dependencies",
          "group": "navigation"
        },
        {
          "command": "nodeforge.clearChat",
          "when": "view == nodeforge.chat",
          "group": "navigation"
        },
        {
          "command": "nodeforge.openDevDocsForWorkspace",
          "when": "view == nodeforge.docs",
          "group": "navigation"
        },
        {
          "command": "nodeforge.syncDevDocsOffline",
          "when": "view == nodeforge.docs",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "nodeforge.searchDevDocs",
          "when": "editorTextFocus",
          "group": "navigation@95"
        }
      ],
      "view/item/context": [
        {
          "command": "nodeforge.stopProcess",
          "when": "view == nodeforge.runtime && viewItem == process",
          "group": "inline"
        },
        {
          "command": "nodeforge.openAdvisoryUrl",
          "when": "view == nodeforge.dependencies && viewItem == detail",
          "group": "inline"
        },
        {
          "command": "nodeforge.copyAdvisoryUrl",
          "when": "view == nodeforge.dependencies && viewItem == detail",
          "group": "9_cutcopypaste"
        }
      ]
    },
    "commands": [
      {
        "command": "nodeforge.analyzeWorkspace",
        "title": "NodeForge: Analyze Workspace",
        "category": "NodeForge"
      },
      {
        "command": "nodeforge.refresh",
        "title": "NodeForge: Refresh",
        "category": "NodeForge"
      },
      {
        "command": "nodeforge.runDiagnostics",
        "title": "NodeForge: Run Diagnostics",
        "category": "NodeForge",
        "icon": "$(play)"
      },
      {
        "command": "nodeforge.runTests",
        "title": "NodeForge: Run Tests",
        "category": "NodeForge",
        "icon": "$(run)"
      },
      {
        "command": "nodeforge.refreshGit",
        "title": "NodeForge: Refresh Git State",
        "category": "NodeForge",
        "icon": "$(refresh)"
      },
      {
        "command": "nodeforge.detectDatabase",
        "title": "NodeForge: Detect Database Schema",
        "category": "NodeForge",
        "icon": "$(database)"
      },
      {
        "command": "nodeforge.auditDependencies",
        "title": "NodeForge: Audit Dependencies",
        "category": "NodeForge",
        "icon": "$(shield)"
      },
      {
        "command": "nodeforge.analyzeDependencyGraph",
        "title": "NodeForge: Analyze Dependency Graph",
        "category": "NodeForge",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "nodeforge.setChatApiKey",
        "title": "NodeForge: Set Chat API Key",
        "category": "NodeForge"
      },
      {
        "command": "nodeforge.clearChat",
        "title": "NodeForge: Clear Chat",
        "category": "NodeForge",
        "icon": "$(clear-all)"
      },
      {
        "command": "nodeforge.openChat",
        "title": "NodeForge: Open Chat",
        "category": "NodeForge"
      },
      {
        "command": "nodeforge.openDevDocs",
        "title": "NodeForge: Open DevDocs Home",
        "category": "NodeForge"
      },
      {
        "command": "nodeforge.openDevDocsForWorkspace",
        "title": "NodeForge: Open DevDocs for Workspace",
        "category": "NodeForge",
        "icon": "$(book)"
      },
      {
        "command": "nodeforge.searchDevDocs",
        "title": "NodeForge: Search DevDocs",
        "category": "NodeForge"
      },
      {
        "command": "nodeforge.syncDevDocsOffline",
        "title": "NodeForge: Sync DevDocs Offline",
        "category": "NodeForge",
        "icon": "$(cloud-download)"
      },
      {
        "command": "nodeforge.showOutput",
        "title": "NodeForge: Show Output",
        "category": "NodeForge"
      },
      {
        "command": "nodeforge.stopProcess",
        "title": "Stop Process",
        "category": "NodeForge",
        "icon": "$(debug-stop)"
      },
      {
        "command": "nodeforge.copyAdvisoryUrl",
        "title": "Copy Advisory URL",
        "category": "NodeForge",
        "icon": "$(copy)"
      },
      {
        "command": "nodeforge.openAdvisoryUrl",
        "title": "Open Advisory URL",
        "category": "NodeForge",
        "icon": "$(link-external)"
      },
      {
        "command": "nodeforge.applyEslintFix",
        "title": "NodeForge: Apply ESLint --fix",
        "category": "NodeForge",
        "icon": "$(wand)"
      },
      {
        "command": "nodeforge.applyBiomeFix",
        "title": "NodeForge: Apply Biome Safe Fixes",
        "category": "NodeForge",
        "icon": "$(wand)"
      },
      {
        "command": "nodeforge.formatCurrentFile",
        "title": "NodeForge: Format Current File",
        "category": "NodeForge",
        "icon": "$(align-left)"
      },
      {
        "command": "nodeforge.runTestFromFile",
        "title": "NodeForge: Run Tests from Current File",
        "category": "NodeForge"
      },
      {
        "command": "nodeforge.debugTestFromFile",
        "title": "NodeForge: Debug Test at Cursor",
        "category": "NodeForge"
      },
      {
        "command": "nodeforge.startDevServer",
        "title": "NodeForge: Start Dev Server",
        "category": "NodeForge",
        "icon": "$(play)"
      },
      {
        "command": "nodeforge.showDependencyGraph",
        "title": "NodeForge: Show Dependency Graph",
        "category": "NodeForge",
        "icon": "$(graph)"
      },
      {
        "command": "nodeforge.showDatabaseSchema",
        "title": "NodeForge: Show Database Schema (ER Diagram)",
        "category": "NodeForge",
        "icon": "$(table)"
      }
    ],
    "configuration": {
      "title": "NodeForge",
      "properties": {
        "nodeforge.runtime.preferredNodeBinary": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path to a Node binary used for spawned commands. If empty, NodeForge uses PATH resolution."
        },
        "nodeforge.diagnostics.aggressiveRefresh": {
          "type": "boolean",
          "default": false,
          "description": "If true, refresh diagnostics on every file save instead of debouncing."
        },
        "nodeforge.chat.baseUrl": {
          "type": "string",
          "default": "https://api.openai.com/v1",
          "description": "OpenAI-compatible API base URL for NodeForge chat."
        },
        "nodeforge.chat.model": {
          "type": "string",
          "default": "gpt-4o-mini",
          "description": "Model id for NodeForge chat."
        },
        "nodeforge.chat.maxToolRounds": {
          "type": "number",
          "default": 8,
          "minimum": 1,
          "maximum": 24,
          "description": "Maximum tool-call rounds per chat message."
        },
        "nodeforge.chat.injectWorkspaceSnapshot": {
          "type": "boolean",
          "default": true,
          "description": "Inject workspace profile and dependency summaries into each chat turn."
        },
        "nodeforge.dependencies.backgroundAudit": {
          "type": "boolean",
          "default": true,
          "description": "Run dependency audit when package.json or lockfiles change (trusted workspaces)."
        },
        "nodeforge.dependencies.backgroundGraphAnalysis": {
          "type": "boolean",
          "default": true,
          "description": "Analyze dependency graph (unused/circular/missing) on activation and when package.json changes (trusted workspaces)."
        },
        "nodeforge.docs.preferExternal": {
          "type": "boolean",
          "default": false,
          "description": "Open DevDocs in the system browser instead of the embedded Docs sidebar view."
        },
        "nodeforge.docs.offline.autoSync": {
          "type": "boolean",
          "default": false,
          "description": "Download DevDocs docsets for the detected workspace stack after activation (network required)."
        },
        "nodeforge.docs.offline.preferOfflineSearch": {
          "type": "boolean",
          "default": true,
          "description": "When synced docsets exist, search offline first and open local HTML pages."
        },
        "nodeforge.docs.offline.extraSlugs": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Additional DevDocs slugs to include when syncing (e.g. react, express)."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "nodeforge.welcome",
        "title": "Get Started with NodeForge",
        "description": "Your autonomous Node.js/TypeScript engineering workspace",
        "steps": [
          {
            "id": "analyze",
            "title": "Analyze Your Workspace",
            "description": "NodeForge detects your runtime, package manager, linter, formatter, test runner, ORM, and more.\n[Analyze Workspace](command:nodeforge.analyzeWorkspace)",
            "media": {
              "markdown": "Open any Node.js/TypeScript project and NodeForge will automatically detect:\n\n- **Runtime**: Node, Bun, or Deno\n- **Package Manager**: npm, pnpm, or yarn\n- **Linter**: ESLint or Biome\n- **Formatter**: Prettier or Biome\n- **Test Runner**: Vitest, Jest, or Node test\n- **ORM**: Prisma or Drizzle\n- **Infrastructure**: Docker, Kubernetes, GitHub Actions\n\nThe profile appears in the **Workspace** view in the NodeForge sidebar."
            }
          },
          {
            "id": "diagnostics",
            "title": "Run Diagnostics",
            "description": "Get TypeScript + ESLint/Biome findings with squigglies in the editor and entries in the Problems panel.\n[Run Diagnostics](command:nodeforge.runDiagnostics)",
            "media": {
              "markdown": "NodeForge bridges diagnostics from all your tools into VS Code's native Problems panel:\n\n- **TypeScript** compiler errors\n- **ESLint** or **Biome** lint findings\n- Editor squigglies (red/yellow/blue)\n- F8 / Shift+F8 navigation\n- Status bar error count\n\nClick the lightbulb (💡) for Quick Fixes like \"Apply ESLint --fix\" or \"Disable rule on this line\"."
            }
          },
          {
            "id": "tests",
            "title": "Run Tests",
            "description": "Run Vitest or Jest with native Test Explorer integration.\n[Run Tests](command:nodeforge.runTests)",
            "media": {
              "markdown": "NodeForge integrates with VS Code's Test Explorer:\n\n- Gutter glyphs (✓ green check / ✗ red X)\n- \"Run Test\" code lenses above `it()` calls\n- Per-test status icons\n- Click a test to jump to its source\n\nUse `Debug Test` to debug a single test with breakpoints."
            }
          },
          {
            "id": "agent",
            "title": "Configure the MCP Agent",
            "description": "Enable AI agents (Cursor, Claude Code) to read your workspace and take actions.\n[Show Agent Setup](command:nodeforge.refresh)",
            "media": {
              "markdown": "NodeForge ships an MCP server with **17 tools**, **6 prompts**, and **22 resource types**.\n\n**Quick setup:**\n1. Build: `cd packages/agent && pnpm build`\n2. Add to `.cursor/mcp.json`:\n```json\n{\n  \"mcpServers\": {\n    \"nodeforge\": {\n      \"command\": \"node\",\n      \"args\": [\"/path/to/nodeforge/packages/agent/dist/cli.js\"],\n      \"env\": { \"NODEFORGE_WORKSPACE_ROOT\": \"/your/project\" }\n    }\n  }\n}\n```\n3. Restart Cursor\n\nThen ask: \"What does this project use?\", \"Run diagnostics\", \"Validate the workspace\"."
            }
          },
          {
            "id": "explore",
            "title": "Explore More Features",
            "description": "Dependency graph, ER diagrams, runtime terminals, git state, and more.",
            "media": {
              "markdown": "**Explore the sidebar views:**\n\n| View | What it shows |\n|------|----------------|\n| Workspace | Detected profile |\n| Diagnostics | Live findings |\n| Tests | Test suite tree |\n| Runtime | Running processes |\n| Git | Branch, dirty status, files |\n| Database | Schema (Prisma/Drizzle) |\n| Dependencies | Vulnerabilities + outdated |\n| Agent | MCP server setup |\n\n**Try these commands:**\n- `NodeForge: Show Dependency Graph` — interactive import graph\n- `NodeForge: Show Database Schema` — ER diagram\n- `NodeForge: Start Dev Server` — launch in a real terminal\n- `NodeForge: Audit Dependencies` — vulnerability scan"
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs --production",
    "dev": "node esbuild.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo \"[extension] integration tests live in packages/extension-vscode-tests — TBD\" && exit 0",
    "test:unit": "echo \"[extension] no unit tests yet\" && exit 0",
    "package": "pnpm build && vsce package --no-dependencies --no-git-tag-version",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@nodeforge/contracts": "workspace:*",
    "@nodeforge/core": "workspace:*",
    "@nodeforge/runner": "workspace:*",
    "@nodeforge/adapter-typescript": "workspace:*",
    "@nodeforge/adapter-eslint": "workspace:*",
    "@nodeforge/adapter-biome": "workspace:*",
    "@nodeforge/adapter-vitest": "workspace:*",
    "@nodeforge/adapter-jest": "workspace:*",
    "@nodeforge/adapter-git": "workspace:*",
    "@nodeforge/adapter-prisma": "workspace:*",
    "@nodeforge/adapter-drizzle": "workspace:*",
    "@nodeforge/adapter-dependencies": "workspace:*",
    "@nodeforge/adapter-dependency-graph": "workspace:*",
    "@nodeforge/adapter-devdocs": "workspace:*",
    "@nodeforge/adapter-prettier": "workspace:*",
    "@nodeforge/agent": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.6.3"
  }
}

{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "composite": true,
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node", "vscode"],
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"],
  "references": [
    { "path": "../contracts" },
    { "path": "../core" },
    { "path": "../runner" },
    { "path": "../adapters/typescript" },
    { "path": "../adapters/eslint" },
    { "path": "../adapters/biome" },
    { "path": "../adapters/vitest" },
    { "path": "../adapters/jest" },
    { "path": "../adapters/git" }
  ]
}
